# GitHub Repository & Access Token
GITHUB_TOKEN=your_github_personal_access_token_or_oauth_token
OWNER=target_github_owner
REPO=target_github_repo
PR_NUMBER=1

# Groq LLM API Key (llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here

# Pinecone Vector DB Configuration for RAG
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_pinecone_index_name_here

# Optional: Server Port (default: 8000)
PYTHON_PORT=8000
